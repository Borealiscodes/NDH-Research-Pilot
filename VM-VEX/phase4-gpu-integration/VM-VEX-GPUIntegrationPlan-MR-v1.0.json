{
  "version": "v1.0",
  "artifact": "VM-VEX-GPUIntegrationPlan-MR",
  "altitude": {
    "min": "A6",
    "max": "A7"
  },
  "permissions": {
    "lanes": [
      "execution-planning",
      "analysis"
    ],
    "forbidden": [
      "runtime",
      "gpu-binding",
      "driver-adjacency",
      "constellation-binding"
    ]
  },
  "gpu-plan": {
    "gpu-memory-envelope": {
      "max-span": 16384,
      "max-regions": 4,
      "region-types": [
        "compute-buffer",
        "staging-buffer",
        "texture-envelope",
        "metadata-envelope"
      ],
      "rules": {
        "forbid-binding": true,
        "forbid-allocation": true,
        "forbid-runtime-adjacency": true,
        "forbid-shader-adjacency": true
      }
    },
    "gpu-safety-ceilings": {
      "allow-planning": true,
      "allow-envelope-definition": true,
      "allow-constraint-definition": true,
      "forbid-binding": true,
      "forbid-execution": true,
      "forbid-runtime": true,
      "forbid-driver-calls": true
    },
    "gpu-ingestion-grammar": {
      "fields": [
        "gpu-envelope",
        "gpu-ceilings",
        "gpu-metadata",
        "gpu-stability-flags"
      ],
      "forbidden-fields": [
        "gpu-runtime-code",
        "gpu-shader-bytecode",
        "gpu-driver-calls"
      ]
    },
    "gpu-stability-ecology": {
      "require-stability-flags": true,
      "forbid-recursion": true,
      "forbid-altitude-crossing": true,
      "forbid-constellation-adjacency": true,
      "forbid-dynamic-math-adjacency": true
    },
    "gpu-placement": {
      "vm-vex-phase": "Phase4-GPUIntegration",
      "isolation-from-ndh-altitude": true,
      "isolation-from-reconstruction": true,
      "isolation-from-constellation": true,
      "isolation-from-triadic-core": true,
      "isolation-from-mkII": true
    }
  },
  "constraints": {
    "strict-ordering": true,
    "strict-altitude": true,
    "strict-lane": true,
    "strict-stability": true,
    "max-depth": 3,
    "max-recursion": 1,
    "max-virtual-span": 12
  },
  "safety-flags": {
    "non_activating": true,
    "pre_runtime_only": true,
    "no_gpu_binding": true,
    "no_driver_adjacency": true,
    "no_constellation_binding": true,
    "stability_ecology_required": true
  },
  "dependencies": {
    "requires": [
      "VM-VEX-ConsolidatedInternalMap-MR-v1.0",
      "VM-VEX-IngestionGrammar-MR-v1.0",
      "VM-VEX-VirtualMemoryMap-MR-v1.0",
      "VM-VEX-StabilityEcologyHooks-MR-v1.0",
      "VM-VEX-BundleInterface-MR-v1.0",
      "VM-VEX-PreRuntimeSequencer-MR-v1.0"
    ],
    "paired-human-readable": "VM-VEX-GPUIntegrationPlan-v1.0"
  },
  "provenance": {
